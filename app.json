{
  "expo": {
    "name": "Depot Bakso Asli Balikpapan",
    "slug": "frontend-app",
    "version": "1.0.0",
    "scheme": "depot-bakso-asli",
    "web": {
      "favicon": "./assets/images/logo_sapi.png"
    },
    "experiments": {
      "tsconfigPaths": true
    },
    "plugins": [
      "expo-secure-store"
    ],
    "orientation": "portrait",
    "icon": "./assets/images/logo_sapi.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/images/logo_sapi.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "splash": {
        "image": "./assets/images/logo_sapi.png",
        "resizeMode": "contain",
        "backgroundColor": "#FFFFFF"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logo_sapi.png",
        "backgroundColor": "#FFFFFF"
      },
      "splash": {
        "image": "./assets/images/logo_sapi.png",
        "resizeMode": "contain",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.nikohoc.baksoasli"
    },
    "extra": {
      "eas": {
        "projectId": "1484fbd2-ffec-45a4-ab5c-0336f7a088c1"
      }
    }
  }
}
